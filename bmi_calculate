def fun_bmi(person,height,weight):
    bmi = weight/(height*height)
    print(person + '的bmi指数为:' + str(bmi))

    if bmi < 18.5:
        print('体重过轻')
    if bmi < 24.9 and bmi >= 18.5:
        print('正常范围')
    if bmi < 29.9 and bmi >= 24.9:
        print('正常范围')
    if bmi >= 29.9:
        print('肥胖')
